# ---------------------------------------------------------------------------------------------
# laya-hub configuration. In Coolify, set these in the application's "Environment Variables" tab.
# For local Docker use:  cp .env.example .env  and edit.
# ---------------------------------------------------------------------------------------------

# ---- Backend: security ----------------------------------------------------------------------
# Shared secret for the /admin/* endpoints (sent as the X-Admin-Secret header).
# Required. Generate one with:  openssl rand -hex 32
ADMIN_SECRET=change-me

# ---- Backend: model -------------------------------------------------------------------------
# Comma-separated Laya checkpoints to preload at startup: english, multilingual, typed-decisions.
# Each is ~0.3-0.4B parameters (~1.3-1.7 GB RAM). With mem_limit 3g, keep this to ONE model.
LAYA_MODELS=english
# What to do when text is routed to a model that is not loaded (e.g. German text with only
# "english" loaded):
#   reject   -> 422 error (default; the English model is confidently wrong on non-English text)
#   fallback -> run on the first loaded model, add "warning": "language_mismatch" to the response
UNLOADED_MODEL_POLICY=reject
# Optional Hugging Face token (only needed if downloads are rate-limited).
HF_TOKEN=

# ---- Backend: performance -------------------------------------------------------------------
# torch CPU threads per prediction.
LAYA_THREADS=4
# Max predictions running at once; extra requests wait up to QUEUE_TIMEOUT_S, then get 503.
MAX_CONCURRENCY=2
QUEUE_TIMEOUT_S=30

# ---- Backend: request limits ----------------------------------------------------------------
# Max size of `state` in bytes (UTF-8 / JSON-encoded).
MAX_STATE_BYTES=20000
# Max questions per request.
MAX_QUESTIONS=20
# Max options per choice question. Confidence is calibrated up to 10; if you raise this,
# answers with more than 10 options get "warning": "uncalibrated_confidence".
MAX_CHOICE_OPTIONS=10
# Max raw request body size in bytes (413 above this).
MAX_BODY_BYTES=256000
# Rate limit (requests/minute) for new API keys when none is given.
DEFAULT_RATE_LIMIT=60

# ---- Backend: storage & logging -------------------------------------------------------------
# SQLite on the persistent /data volume by default. For Postgres/Supabase use e.g.
#   postgresql+psycopg://user:pass@host:5432/dbname   (and add psycopg[binary] to requirements)
DATABASE_URL=sqlite:////data/hub.db
# Store request bodies (first 2 KB) in the call log. Off by default for privacy.
LOG_REQUEST_BODIES=false

# ---- Backend: exposure ----------------------------------------------------------------------
# /admin/* is refused for requests that came through Coolify's public proxy (they carry
# X-Forwarded-For), so giving the backend a domain only exposes /v1 and /health.
# Set to true only if you really want to call the admin API over the internet.
ALLOW_ADMIN_VIA_PROXY=false

# ---- Dashboard -------------------------------------------------------------------------------
# Password for the dashboard login (single admin user). Required.
ADMIN_PASSWORD=change-me-too
# Optional: secret used to sign the session cookie. If empty, it is derived from ADMIN_SECRET +
# ADMIN_PASSWORD (so changing the password signs everyone out).
SESSION_SECRET=
# The session cookie is HTTPS-only automatically when the dashboard is served over https, and a
# normal cookie on plain http (e.g. a generated sslip.io domain). Nothing to configure.
# (To force it, add COOKIE_SECURE: "true" or "false" to the dashboard's environment in docker-compose.yml.)
# (The dashboard reaches the backend at http://backend:8080 on the internal network; ADMIN_SECRET
#  above is shared by both services and never sent to the browser.)
